# ===================================================================
# King X Proxy API - Vercel Environment Variables
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables
# ===================================================================

# YouTube Data API v3 Key (from Google Cloud Console -> Credentials)
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Firebase Admin SDK Service Account JSON string
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the entire single-line JSON string: {"type":"service_account","project_id":"...",...}
# Also used to verify Firebase ID tokens for the wallpapers endpoint.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"chat-app-652fc"}

# Supabase Storage (chat wallpapers) — SERVER-SIDE ONLY.
# Use the Project URL and the *service_role* key. NEVER expose the service-role
# key through EXPO_PUBLIC_* variables, the mobile app, logs or Git.
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional tuning (defaults shown)
SUPABASE_WALLPAPER_BUCKET=chat-wallpapers
WALLPAPER_SIGNED_URL_TTL=3600
WALLPAPER_RATE_MAX=60
WALLPAPER_RATE_WINDOW_MS=60000
