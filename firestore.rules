rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The app uses the Google account id (not the Firebase uid) as the user id,
    // so every ownership check must compare against that id.
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.token.firebase.identities['google.com'][0];
    }

    function isChatMember(chatId) {
      return signedIn() && me() in chatId.split('_');
    }

    // App update info — read before login, so it must be public
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && me() == userId;

      // In-app notifications: anyone signed in can notify a user,
      // only the owner can read / mark read / delete.
      match /notifications/{notificationId} {
        allow create: if signedIn();
        allow read, update, delete: if signedIn() && me() == userId;
      }
    }

    match /chats/{chatId} {
      allow read: if isChatMember(chatId);
      allow create: if isChatMember(chatId)
        && request.resource.data.members is list
        && me() in request.resource.data.members;
      allow update, delete: if isChatMember(chatId);

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == me();
        // reactions, seenBy, unsend, delete-for-me
        allow update: if isChatMember(chatId);
        allow delete: if isChatMember(chatId)
          && resource.data.senderId == me();
      }
    }

    // Friend requests are stored in "requests" with id {from}_{to}
    match /requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && request.resource.data.from == me();
      allow delete: if signedIn()
        && (resource.data.from == me() || resource.data.to == me());
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && me() in request.resource.data.members;
      allow delete: if signedIn() && me() in resource.data.members;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == me();
      // likes are toggled by any signed-in user
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == me();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == me();
        allow delete: if signedIn() && resource.data.authorId == me();
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == me();
      // viewedBy / likedBy are updated by viewers
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == me();
    }

    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == me();
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == me();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == me();
        allow delete: if signedIn() && resource.data.authorId == me();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
