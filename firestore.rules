rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isChatMember(chatId) {
      return signedIn() && me() in chatId.split('_');
    }

    // ─────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────

    match /users/{userId} {

      allow read: if signedIn();

      allow create: if signedIn() &&
        me() == userId;

      allow update: if signedIn() &&
        me() == userId;

      allow delete: if signedIn() &&
        me() == userId;
    }

    // ─────────────────────────────────────────────
    // CHATS
    // ─────────────────────────────────────────────

    match /chats/{chatId} {

      // Only members can read a chat.
      allow read: if isChatMember(chatId);

      // A chat can only be created/updated by one of its members.
      allow create, update: if isChatMember(chatId) &&
        request.resource.data.members is list &&
        me() in request.resource.data.members;

      allow delete: if isChatMember(chatId);

      // ───────────────────────────────────────────
      // CHAT MESSAGES
      // ───────────────────────────────────────────

      match /messages/{messageId} {

        // Members can read messages.
        allow read: if isChatMember(chatId);

        // Only a chat member can create a message,
        // and the sender must be the authenticated user.
        allow create: if isChatMember(chatId) &&
          request.resource.data.senderId == me();

        // Members can update messages.
        //
        // This allows:
        // - reactions
        // - removing reactions
        // - seenBy
        // - unsend
        // - delete-for-me
        // - reply-related message updates
        allow update: if isChatMember(chatId);

        // Only the original sender can permanently delete
        // the message.
        allow delete: if isChatMember(chatId) &&
          resource.data.senderId == me();
      }
    }

    // ─────────────────────────────────────────────
    // FRIEND REQUESTS
    // ─────────────────────────────────────────────

    match /friendRequests/{requestId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if signedIn();

      allow delete: if signedIn();
    }

    // ─────────────────────────────────────────────
    // FRIENDSHIPS
    // ─────────────────────────────────────────────

    match /friendships/{friendshipId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if signedIn();

      allow delete: if signedIn();
    }

    // ─────────────────────────────────────────────
    // POSTS
    // ─────────────────────────────────────────────

    match /posts/{postId} {

      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.userId == me();

      allow update: if signedIn();

      allow delete: if signedIn() &&
        resource.data.userId == me();

      // ───────────────────────────────────────────
      // POST COMMENTS
      // ───────────────────────────────────────────

      match /comments/{commentId} {

        allow read: if signedIn();

        allow create: if signedIn() &&
          request.resource.data.userId == me();

        allow update: if signedIn();

        allow delete: if signedIn() &&
          resource.data.userId == me();
      }
    }

    // ─────────────────────────────────────────────
    // STORIES
    // ─────────────────────────────────────────────

    match /stories/{storyId} {

      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.userId == me();

      allow update: if signedIn();

      allow delete: if signedIn() &&
        resource.data.userId == me();
    }

    // ─────────────────────────────────────────────
    // REELS / VIDEOS
    // ─────────────────────────────────────────────

    match /reels/{reelId} {

      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.userId == me();

      allow update: if signedIn();

      allow delete: if signedIn() &&
        resource.data.userId == me();

      // ───────────────────────────────────────────
      // REEL COMMENTS
      // ───────────────────────────────────────────

      match /comments/{commentId} {

        allow read: if signedIn();

        allow create: if signedIn() &&
          request.resource.data.userId == me();

        allow update: if signedIn();

        allow delete: if signedIn() &&
          resource.data.userId == me();
      }
    }

    // ─────────────────────────────────────────────
    // NOTIFICATIONS
    // ─────────────────────────────────────────────

    match /notifications/{notificationId} {

      allow read: if signedIn() &&
        resource.data.userId == me();

      allow create: if signedIn();

      allow update: if signedIn() &&
        resource.data.userId == me();

      allow delete: if signedIn() &&
        resource.data.userId == me();
    }

    // ─────────────────────────────────────────────
    // DEFAULT DENY
    // ─────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
