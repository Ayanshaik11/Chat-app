rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isChatMember(chatId) {
      return signedIn() &&
        me() in chatId.split('_');
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      allow read: if signedIn();

      allow create: if signedIn() &&
        me() == userId;

      allow update: if signedIn() &&
        me() == userId;

      allow delete: if signedIn() &&
        me() == userId;
    }


    // =========================================================
    // CHATS
    // =========================================================

    match /chats/{chatId} {

      // Both participants can read the chat.
      allow read: if isChatMember(chatId);

      // A new chat must contain its members.
      allow create: if isChatMember(chatId) &&
        request.resource.data.members is list &&
        me() in request.resource.data.members;

      // Existing chat can be updated by either participant.
      //
      // Required for:
      // - typing
      // - unread count
      // - last message
      // - last read
      // - timestamps
      allow update: if isChatMember(chatId);

      allow delete: if isChatMember(chatId);


      // =======================================================
      // MESSAGES
      // =======================================================

      match /messages/{messageId} {

        // Both participants can read messages.
        allow read: if isChatMember(chatId);

        // Only an authenticated participant can create a message,
        // and the sender must be the authenticated Firebase user.
        allow create: if isChatMember(chatId) &&
          request.resource.data.senderId == me();

        // Both participants can update messages.
        //
        // Required for:
        // - reactions
        // - removing reactions
        // - seenBy
        // - unsend
        // - delete for me
        // - other message state
        allow update: if isChatMember(chatId);

        // Permanent deletion is restricted to the sender.
        allow delete: if isChatMember(chatId) &&
          resource.data.senderId == me();
      }
    }


    // =========================================================
    // FRIEND REQUESTS
    // =========================================================

    match /friendRequests/{requestId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if signedIn();

      allow delete: if signedIn();
    }


    // =========================================================
    // FRIENDSHIPS
    // =========================================================

    match /friendships/{friendshipId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if signedIn();

      allow delete: if signedIn();
    }


    // =========================================================
    // POSTS
    // =========================================================

    match /posts/{postId} {

      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.userId == me();

      allow update: if signedIn();

      allow delete: if signedIn() &&
        resource.data.userId == me();


      // =======================================================
      // POST COMMENTS
      // =======================================================

      match /comments/{commentId} {

        allow read: if signedIn();

        allow create: if signedIn() &&
          request.resource.data.userId == me();

        allow update: if signedIn();

        allow delete: if signedIn() &&
          resource.data.userId == me();
      }
    }


    // =========================================================
    // STORIES
    // =========================================================

    match /stories/{storyId} {

      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.userId == me();

      allow update: if signedIn();

      allow delete: if signedIn() &&
        resource.data.userId == me();
    }


    // =========================================================
    // REELS / VIDEOS
    // =========================================================

    match /reels/{reelId} {

      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.userId == me();

      allow update: if signedIn();

      allow delete: if signedIn() &&
        resource.data.userId == me();


      // =======================================================
      // REEL COMMENTS
      // =======================================================

      match /comments/{commentId} {

        allow read: if signedIn();

        allow create: if signedIn() &&
          request.resource.data.userId == me();

        allow update: if signedIn();

        allow delete: if signedIn() &&
          resource.data.userId == me();
      }
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {

      allow read: if signedIn() &&
        resource.data.userId == me();

      allow create: if signedIn();

      allow update: if signedIn() &&
        resource.data.userId == me();

      allow delete: if signedIn() &&
        resource.data.userId == me();
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
